{
  "name": "skyquest-flight-booking",
  "version": "1.0.0",
  "description": "SkyQuest Flight Booking System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "keywords": [
    "electron",
    "flight",
    "booking",
    "skyquest"
  ],
  "author": "SkyQuest Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.skyquest.flightbooking",
    "productName": "SkyQuest Flight Booking",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    }
  }
}
